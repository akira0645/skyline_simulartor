{
  "name": "pixel-city-simulator",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "demos": "node tools/build-demos.mjs",
    "build": "node tools/build-demos.mjs && tsc -p tsconfig.simulation.json && tsc -p tsconfig.json && vite build",
    "test": "npm run test:fast && npm run test:simulation",
    "test:fast": "vitest run --mode fast",
    "test:simulation": "vitest run --mode simulation"
  },
  "dependencies": {
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
